# Server
NODE_ENV=development
PORT=5002
CLIENT_URL=http://localhost:5173

# When true (default behavior even if unset), any missing API key below causes that
# specific feature to run in a clearly-labeled offline/demo mode instead of erroring.
# There isn't a single global switch that disables everything - each integration
# degrades independently. Kept here so it's easy to find/toggle mentally.
DEMO_MODE=true

# Database (falls back to an in-memory MongoDB automatically if this is unreachable -
# good for a quick demo, but data will NOT persist across backend restarts in that mode)
MONGODB_URI=mongodb://localhost:27017/agronix

# Auth
JWT_SECRET=change_this_to_a_long_random_string

# AI (Crop Doctor + Chat Assistant), via Google Gemini. Optional - both features fall
# back to a built-in offline "expert mode" with clearly-labeled mock diagnoses/answers
# when this is not set. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Market Prices. Optional - the app generates clearly-labeled demo prices when this is
# not set. To go live: register at https://data.gov.in/user/register for the mandi
# price dataset API and put the key here (see marketController.ts for the integration point).
MARKET_API_KEY=

# Weather does NOT require an API key - it uses Open-Meteo (free, key-less) for both
# weather and city/PIN-code search. No env var needed.

# Email alerts (Nodemailer via Gmail). Optional - required only for email reports/alerts.
# Use a Gmail "App Password", not your normal account password.
EMAIL_USER=
EMAIL_PASS=

# SMS/WhatsApp alerts (Twilio). Optional - required only for SMS/WhatsApp alerts.
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Note: ThingSpeak channel ID + read key (for live farm sensor data) are supplied
# per-farm from the app UI when you add a farm, not via a global env var.
